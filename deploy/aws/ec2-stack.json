{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private-artifact Streamlit EC2 deployment; no repository push required.",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "ArtifactKey": {
      "Type": "String"
    },
    "ArtifactSha256": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{64}"
    },
    "ClientCidr": {
      "Type": "String",
      "Description": "IPv4 CIDR allowed to access the app (for example your public IP/32)."
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.large",
      "AllowedValues": [
        "t3.medium",
        "t3.large",
        "t3.xlarge"
      ]
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.48.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "Attachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.48.1.0/24",
        "MapPublicIpOnLaunch": true
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "DefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "Attachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Restricted Streamlit access; administration via SSM, no SSH port",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8501,
            "ToPort": 8501,
            "CidrIp": {
              "Ref": "ClientCidr"
            }
          }
        ]
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadDeploymentArtifact",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/${ArtifactKey}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Profile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "Role"
          }
        ]
      }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "DefaultRoute",
        "RouteAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "SubnetId": {
          "Ref": "Subnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "SecurityGroup"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "Profile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 40,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euo pipefail\nexec > >(tee -a /var/log/job-recommender-bootstrap.log) 2>&1\ndnf install -y docker tar gzip\ncommand -v aws >/dev/null || dnf install -y awscli2\nsystemctl enable --now docker\nmkdir -p /opt/job-recommender\naws s3 cp s3://${ArtifactBucket}/${ArtifactKey} /opt/deployment.tar.gz --region ${AWS::Region}\necho \"${ArtifactSha256}  /opt/deployment.tar.gz\" | sha256sum --check\n# The package is generated from an explicit source/model allowlist; it excludes resumes and outcomes.\ntar -xzf /opt/deployment.tar.gz -C /opt/job-recommender\ncd /opt/job-recommender\ndocker build -f Dockerfile.deploy -t job-recommender:deployment .\ncat > /etc/systemd/system/job-recommender.service <<'UNIT'\n[Unit]\nDescription=Job Recommendation Streamlit application\nAfter=docker.service network-online.target\nRequires=docker.service\n[Service]\nRestart=always\nRestartSec=10\nExecStartPre=-/usr/bin/docker rm -f job-recommender\nExecStart=/usr/bin/docker run --rm --name job-recommender --read-only --tmpfs /tmp:rw,size=512m --cap-drop ALL --security-opt no-new-privileges -p 8501:8501 job-recommender:deployment\nExecStop=/usr/bin/docker stop job-recommender\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now job-recommender\n"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Instance"
      }
    },
    "AppUrl": {
      "Value": {
        "Fn::Sub": "http://${Instance.PublicIp}:8501"
      }
    },
    "HealthUrl": {
      "Value": {
        "Fn::Sub": "http://${Instance.PublicIp}:8501/_stcore/health"
      }
    }
  }
}
