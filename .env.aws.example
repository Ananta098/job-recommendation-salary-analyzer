# AWS settings for deployment. Copy this file to .env.aws (make aws-deploy does it for you)
# and replace the two PASTE_ values. .env.aws is ignored by Git and never enters the image.
#
# Where to get the keys: AWS console > IAM > Users > your user > Security credentials > Create access key.
AWS_ACCESS_KEY_ID=PASTE_YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_SECRET_ACCESS_KEY

# Needed for AWS Academy Learner Lab (third line under AWS Details > AWS CLI); otherwise leave empty.
AWS_SESSION_TOKEN=

# Region to deploy in. AWS Academy Learner Lab allows only us-east-1 or us-west-2.
AWS_DEFAULT_REGION=us-east-1

# Optional. Leave empty and they are worked out automatically.
STACK_NAME=job-recommender
INSTANCE_TYPE=t3.large
# Who may open the app. Empty = only your current public IP.
ALLOWED_CIDR=
# Empty = a private bucket named job-recommender-<account>-<region> is created.
S3_BUCKET=
# Existing EC2 instance profile. Empty = create one (Learner Lab is detected and uses LabInstanceProfile).
INSTANCE_PROFILE=

# ---- Logs (optional) ----
# Days to keep app and bootstrap logs in CloudWatch.
LOG_RETENTION_DAYS=14
